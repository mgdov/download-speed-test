{
  "name": "download-speed-test",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript CLI for 10 sequential HTTP downloads on Node.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/download.js",
    "test": "npm run build && node --test dist/speed-test.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
